{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1376px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Tinte",
          "color": "#111114"
        },
        {
          "slug": "white",
          "name": "Weiß",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface",
          "name": "Fläche",
          "color": "#F1F1F2"
        },
        {
          "slug": "accent",
          "name": "Rot",
          "color": "#D3202F"
        },
        {
          "slug": "gold",
          "name": "Gold",
          "color": "#C9A227"
        },
        {
          "slug": "muted",
          "name": "Grau",
          "color": "#55555D"
        },
        {
          "slug": "honamas-black",
          "name": "HONAMAS Black (alt)",
          "color": "#111114"
        },
        {
          "slug": "honamas-off-white",
          "name": "HONAMAS Off White (alt)",
          "color": "#F6F4F0"
        },
        {
          "slug": "honamas-white",
          "name": "HONAMAS White (alt)",
          "color": "#FFFFFF"
        },
        {
          "slug": "honamas-red",
          "name": "HONAMAS Red (alt)",
          "color": "#C8102E"
        },
        {
          "slug": "honamas-gold",
          "name": "HONAMAS Gold (alt)",
          "color": "#C9A227"
        },
        {
          "slug": "honamas-grey",
          "name": "HONAMAS Grey (alt)",
          "color": "#6C6C72"
        }
      ]
    },
    "spacing": {
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      },
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2XS",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "XS",
          "size": "0.75rem"
        },
        {
          "slug": "40",
          "name": "S",
          "size": "1rem"
        },
        {
          "slug": "50",
          "name": "M",
          "size": "1.5rem"
        },
        {
          "slug": "60",
          "name": "L",
          "size": "2.25rem"
        },
        {
          "slug": "70",
          "name": "XL",
          "size": "3.5rem"
        },
        {
          "slug": "80",
          "name": "2XL",
          "size": "5rem"
        },
        {
          "slug": "90",
          "name": "3XL",
          "size": "7rem"
        }
      ],
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Montserrat",
          "fontFamily": "Montserrat, Arial, Helvetica, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1rem",
          "fluid": false
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.25rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "X Large",
          "size": "2rem",
          "fluid": {
            "min": "1.5rem",
            "max": "2.5rem"
          }
        },
        {
          "slug": "display",
          "name": "Display",
          "size": "4.75rem",
          "fluid": {
            "min": "2.75rem",
            "max": "6.5rem"
          }
        }
      ]
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": true
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": true
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|white",
      "text": "var:preset|color|ink"
    },
    "spacing": {
      "blockGap": "0px",
      "padding": {
        "top": "0px",
        "right": "0px",
        "bottom": "0px",
        "left": "0px"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "18px",
      "lineHeight": "1.55"
    },
    "elements": {
      "link": {
        "color": {
          "text": "inherit"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "blank",
      "title": "Blank",
      "postTypes": [
        "page",
        "post"
      ]
    }
  ]
}
